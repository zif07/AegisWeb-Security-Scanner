{
  "manifest_version": 3,
  "name": "AegisWeb Security Scanner",
  "version": "0.1.0",
  "description": "Detects website technologies, analyzes security settings, and scans for vulnerabilities.",
  "permissions": ["webRequest", "tabs", "cookies", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WebGuard Analyzer",
    "default_popup": "popup/popup.html",
    "default_icon": "assets/logo-light.png"
  },
  "icons": {
    "16": "assets/logo-light.png",
    "48": "assets/logo-light.png",
    "128": "assets/logo-light.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/utils.js",
        "content/tech-detector.js",
        "content/active-scanner.js",
        "content/widget.js",
        "content/main.js"
      ],
      "run_at": "document_end"
    }
  ]
}
